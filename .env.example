# No credentials required for real replay + deterministic demo commentary.
# Azure OpenAI: resource endpoint and key from the Azure portal (Keys and Endpoint).
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
# Deployment names on that resource (not model names).
AZURE_OPENAI_TEXT_DEPLOYMENT=gpt-6-luna
AZURE_OPENAI_VOICE_DEPLOYMENT=gpt-live-1
# Optional voice behaviour: persistent (one session per host) | warm | fresh; strict = exact reading.
VOICE_SESSION_MODE=persistent
VOICE_PERFORMANCE=
VOICE_HOLD_MS=350
AGENT_A_URL=http://127.0.0.1:8001
AGENT_B_URL=http://127.0.0.1:8002
# Optional LangGraph tracing. Local traces and SQLite work without it.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=banterbots
